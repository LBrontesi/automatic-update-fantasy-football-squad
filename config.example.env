# Copy this file to .env and fill in your values. Never commit .env.

FANTA_EMAIL=your-email@example.com
FANTA_PASSWORD=your-password

# Comma-separated formation page URLs, one per league.
LEAGUE_URLS=https://leghe.fantacalcio.it/rusticatorsapienza/area-gioco/inserisci-formazione?id=362238,https://leghe.fantacalcio.it/ilprimoverofanta/area-gioco/inserisci-formazione?id=416045

# true = no browser window (required on GitHub Actions), false = visible browser
HEADLESS=true

# Lineup to pick, defenders-centre-midfielders-forwards (goalkeeper is always 1).
FORMATION=3-4-3

# Scoring weights for the "historical" prediction source:
# avg (last-5 votes), trend (last-3 vs last-5), home advantage, opponent weakness.
# WEIGHTS_AVG=0.4
# WEIGHTS_TREND=0.3
# WEIGHTS_HOME=0.2
# WEIGHTS_OPPONENT=0.1

# Prediction source: historical (past league votes) or external (not implemented yet).
PREDICTION_SOURCE=historical
