# Copy this file to .env and fill in your values. Never commit .env.

FANTACALCIO_EMAIL=your-email@example.com
FANTACALCIO_PASSWORD=your-password

# Comma-separated formation page URLs, one per league.
LEAGUE_URL=https://leghe.fantacalcio.it/your-league/view/competition/123456/lineup,https://leghe.fantacalcio.it/another-league/view/competition/234567/lineup

# true = no browser window (required on GitHub Actions), false = visible browser
HEADLESS=true

# On a match day, run only before the first kickoff. On other days, run normally.
# Set false to bypass this safety check for a manual test.
SKIP_AFTER_FIRST_GAME=true
SCHEDULE_URL=https://www.fantacalcio.it/serie-a/calendario
SCHEDULE_TIMEZONE=Europe/Rome

# auto chooses the best formation among those offered by each league.
# Or use a fixed Classic formation such as 3-4-3.
FORMATION=auto

# Scoring weights for the "historical" prediction source:
# Live roster cards supply FM/MV averages and starting likelihood.
# No artificial history/trend, home or opponent values are generated.
# WEIGHTS_AVG=0.4
# WEIGHTS_TREND=0.3
# WEIGHTS_HOME=0.2
# WEIGHTS_OPPONENT=0.1

# Prediction source: historical (past league votes) or external (not implemented yet).
PREDICTION_SOURCE=historical

# true = recompute and replace an existing lineup; false = preserve it.
REPLACE_EXISTING_LINEUP=true

# true computes and reports recommendations without changing saved lineups.
DRY_RUN=false
